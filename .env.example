# Server
PORT=5173
# auto = live when both APIs are configured, demo when credentials are missing.
# true = always demo. false = require live credentials.
DEMO_MODE=auto

# Shopify Admin API
# SHOPIFY_SHOP is the myshopify subdomain only, for example antique-candle-co.
SHOPIFY_SHOP=
SHOPIFY_API_VERSION=2026-07
# Preferred for this project because it matches the existing notebook.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: use an existing Admin API access token instead of client credentials.
SHOPIFY_ACCESS_TOKEN=

# NetSuite SuiteTalk REST Web Services
# Use the account ID/realm format shown in NetSuite, for example 1234567 or 1234567_SB1.
NETSUITE_ACCOUNT_ID=
# Matches testnetsuite.py: OAuth 2.0 client credentials with a JWT client assertion.
NETSUITE_AUTH_MODE=oauth2_jwt
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_PRIVATE_KEY_PATH=certs/private.pem

# Optional: use a pre-generated bearer token instead of JWT client credentials.
# Set NETSUITE_AUTH_MODE=oauth2_bearer when using this.
NETSUITE_OAUTH2_ACCESS_TOKEN=

# Token-Based Authentication fallback
# Set NETSUITE_AUTH_MODE=tba when using these values.
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# NetSuite sales-order candle units for ASP denominator.
NETSUITE_SALES_TRANSACTION_TYPE=SalesOrd
NETSUITE_SALES_EXTERNAL_ID_PREFIX=SHPF

# Optional on-hand inventory query, retained for diagnostics.
NETSUITE_SUITEQL_INVENTORY_QUERY=SELECT SUM(item.totalquantityonhand) AS quantity_on_hand FROM item WHERE item.isinactive = 'F'
